# NEAR validator per-host configuration. Copy to /etc/near-city-nodes/node.env on
# the box (mode 600 root:root) and fill in the required fields. Back up the
# populated file to a private secrets vault BEFORE shipping.

# === Identity (required) ===
# Operator-visible name. Appears in Telegram messages, Grafana labels, log
# prefixes. Short kebab-case lowercase, must match ^[a-z][a-z0-9-]+$.
OPERATOR_NAME=<your-node-name>

# Local unix user with limited sudo (start/stop neard, run update-near.sh,
# touch/rm pause-upgrades). Created by phase 03 if missing.
OPERATOR_USER=<your-operator-username>

# Path on the box where operator's public key was scp'd before bootstrap.
# Phase 03 copies this to /home/${OPERATOR_USER}/.ssh/authorized_keys.
OPERATOR_SSH_PUBKEYS_FILE=/etc/near-city-nodes/operator_authorized_keys

# Public IPv4 of this host. Injected into config.json network.public_addrs as
# <node_pubkey>@<ip>:24567. Required for chunk-validator advertisement.
NODE_PUBLIC_IP=

# === NEAR network (required) ===
NETWORK=mainnet

# Initial nearcore tag to build at first deploy. Once running, update-near.sh
# manages further upgrades and this value is no longer authoritative.
NEARCORE_TAG=2.11.1

# Protocol epoch length in blocks. Mainnet and testnet are both 43200 as of
# protocol version 83. Only change if NEAR ships a protocol-level change.
EPOCH_LENGTH=43200

# Upstream NEAR RPC used to cross-check block height independent of the local
# node. Override if the operator has a dedicated RPC endpoint.
NEAR_RPC_URL=https://rpc.mainnet.near.org

# === Pool identity (optional pre-deploy, required pre-stake) ===
# Empty until the pool contract is deployed (e.g. <pool-name>.pool.near). When
# filled, re-run: ./bootstrap.sh --phase 06-neard-init --force
POOL_ACCOUNT=

# === Telegram (required) ===
# Per-node bot ,  alerts for THIS node go here. Generate via @BotFather, grab
# chat_id from https://api.telegram.org/bot<token>/getUpdates after sending /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Telegram fleet aggregator (optional) ===
# Optional second bot that receives a copy of every alert from this node, used
# by an ops lead who wants ALL fleet alerts in one DM stream. Same token+chat
# value across every box in the fleet (the box's OPERATOR_NAME prefix in the
# message disambiguates source). Leave both empty to disable fleet delivery.
TELEGRAM_FLEET_BOT_TOKEN=
TELEGRAM_FLEET_CHAT_ID=

# === Local neard (sane defaults; rarely overridden) ===
SERVICE_NAME=neard-mainnet
IMAGE_NAME=nearcore
DOCKER_BUILD_CONTEXT=/opt/nearcore-docker
LOCAL_STATUS_URL=http://localhost:3030/status
LOCAL_METRICS_URL=http://localhost:3030/metrics

# === Updater (sane defaults) ===
# Tracks which version :current points at. Updated atomically per upgrade.
VERSION_FILE=/var/lib/near-city-nodes/current_version

# Number of versioned images to keep locally. Older images pruned after each
# successful update.
KEEP_IMAGES=3

# Abort an upgrade if we are more than this percent through the current epoch
# at decision time. The epoch-boundary check is absolute and is NEVER bypassed,
# including for security releases. Mid-epoch restarts cause real failures.
MAX_EPOCH_PROGRESS=75

# Minimum peer count after restart for the upgrade to be marked healthy.
# Below this, the script sends a warning. Zero triggers a full rollback.
MIN_PEER_COUNT=20

# Seconds to wait after systemctl restart before running the health check.
STABILIZATION_WAIT=90

# Existence of this file disables the updater. Operators touch it during
# manual maintenance windows and rm it to re-enable auto-updates.
PAUSE_FILE=/etc/near-city-nodes/pause-upgrades

# Local audit log. Every run appends a timestamped line. Rotated weekly.
AUDIT_LOG=/var/log/near-city-nodes/update.log

# === Grafana (first-install) ===
# If empty, phase 08 generates a 40-char alphanumeric password and writes it
# to /root/.grafana_admin_password (mode 600 root:root).
GRAFANA_ADMIN_PASSWORD=

# Bind address for Grafana HTTP. Default 0.0.0.0 means accessible at
# http://<NODE_PUBLIC_IP>:3000 (UFW opens port 3000). Set to 127.0.0.1 for
# ssh-tunnel-only access.
GRAFANA_BIND_ADDRESS=0.0.0.0
