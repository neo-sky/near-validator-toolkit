apiVersion: 1

policies:
  - orgId: 1
    receiver: telegram-${OPERATOR_NAME}
    group_by: [alertname, severity, instance]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
    routes:
      - receiver: telegram-${OPERATOR_NAME}
        matchers:
          - severity = critical
        group_wait: 0s
        group_interval: 1m
        repeat_interval: 1h
        continue: true
      - receiver: telegram-${OPERATOR_NAME}
        matchers:
          - severity = warning
        group_wait: 30s
        group_interval: 5m
        repeat_interval: 4h
        continue: true
      - receiver: telegram-fleet
        group_wait: 30s
        group_interval: 5m
        repeat_interval: 4h
        continue: false
