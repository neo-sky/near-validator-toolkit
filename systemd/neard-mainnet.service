[Unit]
Description=NEAR Validator Node (mainnet, Docker)
Documentation=https://near-nodes.io
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=30
TimeoutStopSec=90

ExecStart=/usr/bin/docker run \
  --name neard-mainnet \
  --rm \
  --network host \
  --user 998:998 \
  --cap-drop=ALL \
  --security-opt=no-new-privileges:true \
  --read-only \
  --tmpfs /tmp:size=256m \
  --memory=48g \
  --pids-limit=4096 \
  -v /var/lib/neard/.near:/home/neard/.near \
  -v /var/log/near-city-nodes:/var/log/near-city-nodes \
  -e RUST_BACKTRACE=1 \
  nearcore:current \
  --home /home/neard/.near run

ExecStop=/usr/bin/docker stop -t 60 neard-mainnet

[Install]
WantedBy=multi-user.target
